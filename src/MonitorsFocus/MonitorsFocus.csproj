  <ItemGroup>
    <ProjectReference Include="../MonitorsFocus.Core/MonitorsFocus.Core.csproj" />
    <PackageReference Include="System.Management" Version="10.0.14" />
    <InternalsVisibleTo Include="MonitorsFocus.Tests" />
    <EmbeddedResource Include="Assets/tray-*.ico" />
  </ItemGroup>
</Project>
